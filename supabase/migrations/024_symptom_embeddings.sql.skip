-- 024: Symptom Embeddings — vector storage for semantic search fallback
-- Uses pgvector extension for cosine similarity search
-- Populated by scripts/generate-embeddings.js (run manually when symptoms change)
-- NOTE: Requires pgvector extension enabled in Supabase Dashboard (Database → Extensions)
-- This migration is skipped if extension is not available

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'vector') THEN
    RAISE NOTICE 'pgvector extension not enabled. Skipping symptom_embeddings table creation. Enable it in Supabase Dashboard → Database → Extensions.';
    RETURN;
  END IF;

  -- pgvector extension must be enabled in Supabase dashboard (Database → Extensions)
  CREATE EXTENSION IF NOT EXISTS vector;

  EXECUTE '
    CREATE TABLE IF NOT EXISTS public.symptom_embeddings (
        symptom_id TEXT PRIMARY KEY REFERENCES public.symptoms(id) ON DELETE CASCADE,
        label TEXT NOT NULL,
        embedding vector(768) NOT NULL,
        created_at TIMESTAMPTZ DEFAULT now()
    )
  ';

  -- IVFFlat index for fast nearest-neighbor cosine search
  -- Rebuild after significant data changes: REINDEX INDEX idx_symptom_embeddings_vector;
  EXECUTE '
    CREATE INDEX IF NOT EXISTS idx_symptom_embeddings_vector
        ON public.symptom_embeddings
        USING ivfflat (embedding vector_cosine_ops)
        WITH (lists = 10)
  ';

  -- RLS: public read (needed for fallback queries), service role write
  EXECUTE 'ALTER TABLE public.symptom_embeddings ENABLE ROW LEVEL SECURITY';

  EXECUTE '
    DROP POLICY IF EXISTS "Public can read embeddings" ON public.symptom_embeddings;
    CREATE POLICY "Public can read embeddings"
        ON public.symptom_embeddings
        FOR SELECT
        TO public
        USING (true)
  ';

  EXECUTE '
    DROP POLICY IF EXISTS "Service role can manage embeddings" ON public.symptom_embeddings;
    CREATE POLICY "Service role can manage embeddings"
        ON public.symptom_embeddings
        FOR ALL
        TO service_role
        USING (true)
        WITH CHECK (true)
  ';
END $$;
