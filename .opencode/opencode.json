{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk_omniroute"
      },
      "models": {
        "auto/best-coding": { "name": "auto/best-coding" },
        "auto/coding": { "name": "auto/coding" },
        "auto/best-reasoning": { "name": "auto/best-reasoning" },
        "auto/best-fast": { "name": "auto/best-fast" },
        "aug/gemini-3.1-pro": { "name": "aug/gemini-3.1-pro" },
        "aug/gemini-3.0-flash": { "name": "aug/gemini-3.0-flash" }
      }
    }
  },
  "agent": {
    "council-design-reviewer": {
      "model": "anthropic/claude-sonnet-4-6",
      "mode": "subagent",
      "description": "Reviews UI components for design system compliance, accessibility, and visual consistency.",
      "permission": { "edit": "deny", "bash": "deny", "glob": "allow", "grep": "allow", "read": "allow" }
    },
    "council-code-reviewer": {
      "model": "anthropic/claude-sonnet-4-6",
      "mode": "subagent",
      "description": "Reviews code for correctness, performance, security, and adherence to project patterns.",
      "permission": { "edit": "deny", "bash": "deny", "glob": "allow", "grep": "allow", "read": "allow" }
    },
    "council-security-reviewer": {
      "model": "anthropic/claude-sonnet-4-6",
      "mode": "subagent",
      "description": "Reviews code for XSS, injection, data exposure, and other security vulnerabilities.",
      "permission": { "edit": "deny", "bash": "deny", "glob": "allow", "grep": "allow", "read": "allow" }
    }
  }
}
